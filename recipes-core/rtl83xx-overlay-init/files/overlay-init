#!/bin/sh
# Root filesystem setup for the flash image. The kernel runs this as init=
# (bootargs in rtl8380_zyxel_gs1900.dtsi), before busybox init.
#
# The squashfs root is read-only. Stack an overlay on it whose upper layer
# lives on the JFFS2 "data" partition, pivot into the overlay and hand over to
# /sbin/init. This is OpenWrt's mount_root arrangement: the squashfs stays
# visible under /rom and the upper layer under /overlay.

PATH=/sbin:/bin:/usr/sbin:/usr/bin

log() {
    echo "overlay-init: $*"
}

if mount -t jffs2 -o noatime mtd:data /overlay; then
    log "mtd:data mounted on /overlay"
else
    log "cannot mount mtd:data, changes will NOT survive a reboot"
    mount -t tmpfs -o mode=0755 tmpfs /overlay
fi

mkdir -p /overlay/upper /overlay/work

# lowerdir=/ sees only the squashfs itself, not the mounts on top of it.
if mount -t overlay -o noatime,lowerdir=/,upperdir=/overlay/upper,workdir=/overlay/work \
        overlay /mnt && pivot_root /mnt /mnt/rom; then
    mount --move /rom/overlay /overlay
    # devtmpfs_mount() put a devtmpfs on the squashfs' /dev.
    mount --move /rom/dev /dev 2>/dev/null
else
    log "cannot set up the overlay, continuing on the read-only squashfs"
fi

# Neither of these may land on the 2 MiB JFFS2: SWUpdate unpacks a whole .swu
# into /tmp, and /var/log is a symlink into /var/volatile. The image drops
# /var/volatile from fstab (rtl83xx-image.bb), since "mount -a" would otherwise
# stack a second, empty tmpfs over the directories created here.
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /var/volatile
mkdir -p /var/volatile/log /var/volatile/tmp

exec /sbin/init
