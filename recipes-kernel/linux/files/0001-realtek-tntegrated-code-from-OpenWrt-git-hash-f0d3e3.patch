+void rtldsa_931x_print_matrix(void)
+{
+	int tbl = otto_table_acquire(RTL9310_TBL_PORT_ISO_CTRL);
+	u32 v[2];
+
+	for (int i = 0; i < 64; i++) {
+		__otto_table_read(tbl, i, &v);
+		pr_debug("> %08x %08x\n", v[0], v[1]);
+	}
+	otto_table_release(tbl);
+}
