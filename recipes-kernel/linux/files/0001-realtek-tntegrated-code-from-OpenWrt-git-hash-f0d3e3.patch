+
+	mask |= valid ? RTL930X_LOCAL_PORT_TRK_MAP_IS_TRK_MBR : 0;
+	mask |= FIELD_PREP(RTL930X_LOCAL_PORT_TRK_MAP_TRK_ID, group);
+	sw_w32(mask, RTL930X_LOCAL_PORT_TRK_MAP + (4 * port));
+}
