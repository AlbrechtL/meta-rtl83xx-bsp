+	mask |= valid ? RTL930X_TRK_ID_CTRL_TRK_VALID : 0;
+	mask |= FIELD_PREP(RTL930X_TRK_ID_CTRL_TRK_ID, global_group);
+	sw_w32(mask, RTL930X_TRK_ID_CTRL + (4 * local_group));
