+static void rteth_930x_hw_stop(struct rteth_ctrl *ctrl)
+{
+	/* TODO: L2 flush needed */
+
+	/* CPU-Port: Link down */
+	regmap_clear_bits(ctrl->map, ctrl->cfg->mac_force_mode_ctrl, 0x3);
+}
