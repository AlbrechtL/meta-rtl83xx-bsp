diff --git a/drivers/net/dsa/rtl83xx/dsa.c b/drivers/net/dsa/rtl83xx/dsa.c
new file mode 100644
index 000000000..274422155
--- /dev/null
+++ b/drivers/net/dsa/rtl83xx/dsa.c
