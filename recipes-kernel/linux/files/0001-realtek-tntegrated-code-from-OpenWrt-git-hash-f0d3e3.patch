+static void otto_l3_839x_route_read(struct otto_l3_ctrl *ctrl, int idx, struct otto_l3_route *rt)
+{
+	u32 data[2];
+	u64 v;
+
+	otto_table_read(RTL8390_TBL_ROUTING, idx, &data);
+
+	v = data[0];
+	v <<= 32;
+	v |= data[1];
+	rt->switch_mac_id = (v >> 12) & 0xf;
+	rt->nh.gw = v >> 16;
