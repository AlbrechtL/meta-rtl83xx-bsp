+static int rtpcs_931x_init(struct rtpcs_ctrl *ctrl)
+{
+	int ret;
+
+	ret = rtpcs_931x_init_mac_groups(ctrl);
+	if (ret < 0)
+		return ret;
+
+	return rtpcs_93xx_init(ctrl);
+}
