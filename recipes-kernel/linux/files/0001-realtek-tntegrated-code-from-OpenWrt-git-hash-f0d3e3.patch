+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <net/dsa.h>
+#include <linux/etherdevice.h>
+#include <linux/if_bridge.h>
+#include <linux/if_vlan.h>
+#include <linux/pcs/pcs.h>
+#include <asm/mach-rtl-otto/mach-rtl-otto.h>
