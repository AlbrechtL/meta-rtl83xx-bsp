+static void rteth_tx_timeout(struct net_device *dev, unsigned int txqueue)
+{
+	struct rteth_ctrl *ctrl = netdev_priv(dev);
+
+	netif_tx_stop_all_queues(dev);
+	schedule_work(&ctrl->reset_work);
+}
