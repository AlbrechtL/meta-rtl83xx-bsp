Subject: [PATCH] realtek: dts: gs1900: data partition and flash root bootargs

Merge the two 1 MiB Zyxel "jffs"/"jffs2" partitions into one 2 MiB "data"
partition, which holds the JFFS2 upper layer of the root overlay. It is a
partition of its own so that rewriting "firmware" during an upgrade leaves it
alone. "firmware" itself is unchanged: mtdsplit_uimage splits it into kernel
and rootfs, and MTD_ROOTFS_ROOT_DEV makes "rootfs" the root device.

bootargs add rootfstype=squashfs for that root and init=/sbin/overlay-init,
which stacks the overlay before busybox init starts. A kernel with a bundled
initramfs runs /init instead and ignores init=, so one DTB serves both the
TFTP initramfs and the flash kernel.

Upstream-Status: Inappropriate [meta-rtl83xx-bsp flash layout]
---
--- a/arch/mips/boot/dts/realtek/rtl8380_zyxel_gs1900.dtsi
+++ b/arch/mips/boot/dts/realtek/rtl8380_zyxel_gs1900.dtsi
@@ -6,6 +6,10 @@
 #include <dt-bindings/gpio/gpio.h>
 
 / {
+	chosen {
+		bootargs = "earlycon rootfstype=squashfs init=/sbin/overlay-init";
+	};
+
 	aliases {
 		led-boot = &led_sys;
 		led-failsafe = &led_sys;
@@ -68,13 +72,10 @@
 				label = "u-boot-env2";
 				reg = <0x50000 0x10000>;
 			};
+			/* Zyxel's "jffs" + "jffs2", used as the JFFS2 overlay upper layer */
 			partition@60000 {
-				label = "jffs";
-				reg = <0x60000 0x100000>;
-			};
-			partition@160000 {
-				label = "jffs2";
-				reg = <0x160000 0x100000>;
+				label = "data";
+				reg = <0x60000 0x200000>;
 			};
 			partition@b260000 {
 				label = "firmware";
