From 9bf29aab58471e7ec25c5c87564a018f31c63907 Mon Sep 17 00:00:00 2001
From: Albrecht Lohofener <albrecht@albrechtloh.de>
Date: Fri, 25 Sep 2026 08:16:34 +0200
Subject: [PATCH] realtek: dts: add albrecht rtl8382mi-test device tree

Copied verbatim from AlbrechtL/openwrt branch rtl8382mi-test
(target/linux/realtek/dts/rtl8382_albrecht_rtl8382mi-test.dts).

RTL8382M with 20 ports: 8 x RTL8218B over QSGMII, the 8 internal PHYs
and 4 x RTL8214FC over QSGMII. DIP switches are read through a PCA9535
GPIO expander on a bit-banged I2C bus.

Upstream-Status: Inappropriate [board not in OpenWrt]
Signed-off-by: Albrecht Lohofener <albrecht@albrechtloh.de>
---
 arch/mips/boot/dts/realtek/Makefile           |   1 +
 .../rtl8382_albrecht_rtl8382mi-test.dts       | 196 ++++++++++++++++++
 2 files changed, 197 insertions(+)
 create mode 100644 arch/mips/boot/dts/realtek/rtl8382_albrecht_rtl8382mi-test.dts

diff --git a/arch/mips/boot/dts/realtek/Makefile b/arch/mips/boot/dts/realtek/Makefile
index 73fbf54..8452a19 100644
--- a/arch/mips/boot/dts/realtek/Makefile
+++ b/arch/mips/boot/dts/realtek/Makefile
@@ -2,3 +2,4 @@
 dtb-y	+= cisco_sg220-26.dtb
 dtb-y	+= cameo-rtl9302c-2x-rtl8224-2xge.dtb
 dtb-y	+= rtl8380_zyxel_gs1900-8-a1.dtb
+dtb-y	+= rtl8382_albrecht_rtl8382mi-test.dtb
diff --git a/arch/mips/boot/dts/realtek/rtl8382_albrecht_rtl8382mi-test.dts b/arch/mips/boot/dts/realtek/rtl8382_albrecht_rtl8382mi-test.dts
new file mode 100644
index 0000000..d7638c8
--- /dev/null
+++ b/arch/mips/boot/dts/realtek/rtl8382_albrecht_rtl8382mi-test.dts
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+#include "rtl838x.dtsi"
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	compatible = "albrecht,rtl8382mi-test", "realtek,rtl838x-soc";
+	model = "Albrecht RTL8382MI Test Switch";
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x8000000>;
+	};
+
+	leds: leds {
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinmux_disable_sys_led>;
+		compatible = "gpio-leds";
+	};
+
+	i2c_buttons: i2c-gpio-0 {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
+		i2c-gpio,delay-us = <2>;
+		i2c-gpio,scl-open-drain;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpio1: gpio-expander@27 {
+			compatible = "nxp,pca9535";
+			reg = <0x27>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+	};
+
+	keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <20>;
+
+		dip-switch-0 {
+			label = "dip-switch-0";
+			gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;
+			linux,code = <BTN_0>;
+			debounce-interval = <100>;
+		};
+
+		dip-switch-1 {
+			label = "dip-switch-1";
+			gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;
+			linux,code = <BTN_1>;
+			debounce-interval = <100>;
+		};
+
+		dip-switch-2 {
+			label = "dip-switch-2";
+			gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
+			linux,code = <BTN_2>;
+			debounce-interval = <100>;
+		};
+
+		dip-switch-3 {
+			label = "dip-switch-3";
+			gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;
+			linux,code = <BTN_3>;
+			debounce-interval = <100>;
+		};
+
+		dip-switch-4 {
+			label = "dip-switch-4";
+			gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
+			linux,code = <BTN_4>;
+			debounce-interval = <100>;
+		};
+
+		dip-switch-5 {
+			label = "dip-switch-5";
+			gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+			debounce-interval = <100>;
+		};
+	};
+};
+
+&spi0 {
+	status = "okay";
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <10000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "u-boot";
+				reg = <0x00000000 0x0e0000>;
+				read-only;
+			};
+			partition@e0000 {
+				label = "u-boot-env";
+				reg = <0x000e0000 0x010000>;
+			};
+			partition@f0000 {
+				label = "sysinfo";
+				reg = <0x000f0000 0x010000>;
+				read-only;
+			};
+			partition@100000 {
+				label = "jffs2_cfg";
+				reg = <0x00100000 0x100000>;
+			};
+			partition@200000 {
+				label = "jffs2_log";
+				reg = <0x00200000 0x100000>;
+			};
+			partition@300000 {
+				label = "firmware";
+				compatible = "openwrt,uimage", "denx,uimage";
+				openwrt,ih-magic = <0x83800000>;
+				reg = <0x00300000 0x0d00000>;
+			};
+		};
+	};
+};
+
+&mdio_bus0 {
+	PHY_C22(0, 0)
+	PHY_C22(1, 1)
+	PHY_C22(2, 2)
+	PHY_C22(3, 3)
+	PHY_C22(4, 4)
+	PHY_C22(5, 5)
+	PHY_C22(6, 6)
+	PHY_C22(7, 7)
+
+	PHY_C22(8, 8)
+	PHY_C22(9, 9)
+	PHY_C22(10, 10)
+	PHY_C22(11, 11)
+	PHY_C22(12, 12)
+	PHY_C22(13, 13)
+	PHY_C22(14, 14)
+	PHY_C22(15, 15)
+
+	/* TODO: This is a RTL8214FC and should be PHY_C22_SFP() */
+	PHY_C22(24, 24)
+	PHY_C22(25, 25)
+	PHY_C22(26, 26)
+	PHY_C22(27, 27)
+};
+
+&switch0 {
+	ethernet-ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		SWITCH_PORT_SDS(0, 1, 0, 0, qsgmii)
+		SWITCH_PORT_SDS(1, 2, 0, 1, qsgmii)
+		SWITCH_PORT_SDS(2, 3, 0, 2, qsgmii)
+		SWITCH_PORT_SDS(3, 4, 0, 3, qsgmii)
+		SWITCH_PORT_SDS(4, 5, 1, 0, qsgmii)
+		SWITCH_PORT_SDS(5, 6, 1, 1, qsgmii)
+		SWITCH_PORT_SDS(6, 7, 1, 2, qsgmii)
+		SWITCH_PORT_SDS(7, 8, 1, 3, qsgmii)
+
+		SWITCH_PORT(8, 9, internal)
+		SWITCH_PORT(9, 10, internal)
+		SWITCH_PORT(10, 11, internal)
+		SWITCH_PORT(11, 12, internal)
+		SWITCH_PORT(12, 13, internal)
+		SWITCH_PORT(13, 14, internal)
+		SWITCH_PORT(14, 15, internal)
+		SWITCH_PORT(15, 16, internal)
+
+		SWITCH_PORT_SDS(24, 17, 4, 0, qsgmii)
+		SWITCH_PORT_SDS(25, 18, 4, 1, qsgmii)
+		SWITCH_PORT_SDS(26, 19, 4, 2, qsgmii)
+		SWITCH_PORT_SDS(27, 20, 4, 3, qsgmii)
+
+		port@28 {
+			ethernet = <&ethernet0>;
+			reg = <28>;
+			phy-mode = "internal";
+			fixed-link {
+				speed = <1000>;
+				full-duplex;
+			};
+		};
+	};
+};
