From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Albrecht Lohofener <albrecht@albrechtloh.de>
Date: Mon, 14 Sep 2026 12:00:00 +0200
Subject: [PATCH 4/4] realtek: dts: replace rtl838x.dtsi with the OpenWrt
 version

The zyxel gs1900 device trees added in patch 2/3 are copied from OpenWrt
and include rtl838x.dtsi expecting OpenWrt's variant of that file, but
the tree still carried the mainline one. The two are not interchangeable:

  - mainline's rtl838x.dtsi has no /dts-v1/; (mainline puts it in the
    board .dts, OpenWrt puts it in the SoC .dtsi), so dtc fails with
    "rtl838x.dtsi:3.1-2 syntax error" on the very first node,
  - it does not define the mdio_bus0 and switch0 labels that
    rtl8380_zyxel_gs1900.dtsi references,
  - it describes the SoC with the mainline bindings, not the ones the
    OpenWrt driver code integrated in patch 1/3 expects.

Take the file from the same OpenWrt tree as the rest of the device
trees. dt-bindings/clock/rtl83xx-clk.h, which it includes, is already
provided by patch 1/3.

Signed-off-by: Albrecht Lohofener <albrecht@albrechtloh.de>
---
diff --git a/arch/mips/boot/dts/realtek/rtl838x.dtsi b/arch/mips/boot/dts/realtek/rtl838x.dtsi
index ce522a6..db68f60 100644
--- a/arch/mips/boot/dts/realtek/rtl838x.dtsi
+++ b/arch/mips/boot/dts/realtek/rtl838x.dtsi
@@ -1,12 +1,28 @@
-// SPDX-License-Identifier: GPL-2.0-or-later OR BSD-2-Clause
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+#include "macros.dtsi"
+#include <dt-bindings/clock/rtl83xx-clk.h>
+#include <dt-bindings/gpio/gpio.h>
+
+/dts-v1/;
 
 / {
 	#address-cells = <1>;
 	#size-cells = <1>;
 
-	aliases {
-		serial0 = &uart0;
-		serial1 = &uart1;
+	compatible = "realtek,rtl838x-soc";
+
+	osc: oscillator {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <25000000>;
+	};
+
+	ccu: clock-controller {
+		compatible = "realtek,rtl8380-clock";
+		#clock-cells = <1>;
+		clocks = <&osc>;
+		clock-names = "ref_clk";
 	};
 
 	cpus {
@@ -14,17 +30,52 @@
 		#size-cells = <0>;
 
 		cpu@0 {
-			device_type = "cpu";
 			compatible = "mips,mips4KEc";
 			reg = <0>;
-			clocks = <&baseclk>;
+			clocks = <&ccu CLK_CPU>;
+			operating-points-v2 = <&cpu_opp_table>;
 		};
 	};
 
-	baseclk: baseclk {
-		compatible = "fixed-clock";
-		#clock-cells = <0>;
-		clock-frequency = <500000000>;
+	cpu_opp_table: opp-table-0 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp00 {
+			opp-hz = /bits/ 64 <325000000>;
+		};
+		opp01 {
+			opp-hz = /bits/ 64 <350000000>;
+		};
+		opp02 {
+			opp-hz = /bits/ 64 <375000000>;
+		};
+		opp03 {
+			opp-hz = /bits/ 64 <400000000>;
+		};
+		opp04 {
+			opp-hz = /bits/ 64 <425000000>;
+		};
+		opp05 {
+			opp-hz = /bits/ 64 <450000000>;
+		};
+		opp06 {
+			opp-hz = /bits/ 64 <475000000>;
+		};
+		opp07 {
+			opp-hz = /bits/ 64 <500000000>;
+		};
+	};
+
+	aliases {
+		serial0 = &uart0;
+		serial1 = &uart1;
+		mdio-gpio1 = &mdio_gpio;
+	};
+
+	chosen {
+		bootargs = "earlycon";
+		stdout-path = "serial0:115200n8";
 	};
 
 	cpuintc: cpuintc {
@@ -34,18 +85,38 @@
 		interrupt-controller;
 	};
 
-	lx_clk: clock-lexra {
-		compatible = "fixed-clock";
-		#clock-cells = <0>;
-		clock-frequency = <200000000>;
+	/*
+	 * Provided for devices with RTL838xM SoC with revision A silicon.
+	 * Newer SoCs can use the &mdio_aux bus instead.
+	 */
+	mdio_gpio: mdio {
+		compatible = "virtual,mdio-gpio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>,
+			<&gpio0 3 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&mdio_aux_gpio>;
+
+		status = "disabled";
 	};
 
-	soc@18000000 {
+	soc: soc {
 		compatible = "simple-bus";
 		#address-cells = <1>;
 		#size-cells = <1>;
 		ranges = <0x0 0x18000000 0x10000>;
 
+		intc: interrupt-controller@3000 {
+			compatible = "realtek,rtl8380-intc", "realtek,rtl-intc";
+			reg = <0x3000 0x18>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			interrupt-parent = <&cpuintc>;
+			interrupts = <2>, <3>, <4>, <5>, <6>;
+		};
+
 		spi0: spi@1200 {
 			compatible = "realtek,rtl8380-spi";
 			reg = <0x1200 0x100>;
@@ -54,31 +125,42 @@
 			#size-cells = <0>;
 		};
 
-		uart0: serial@2000 {
+		timer0: timer@3100 {
+			compatible = "realtek,rtl8380-timer", "realtek,otto-timer";
+			reg = <0x3100 0x10>, <0x3110 0x10>, <0x3120 0x10>,
+			      <0x3130 0x10>, <0x3140 0x10>;
+
+			interrupt-parent = <&intc>;
+			interrupts = <29 4>, <28 4>, <17 4>, <16 4>, <15 4>;
+			clocks = <&ccu CLK_LXB>;
+		};
+
+		uart0: uart@2000 {
 			compatible = "ns16550a";
 			reg = <0x2000 0x100>;
 
-			clocks = <&lx_clk>;
+			clocks = <&ccu CLK_LXB>;
 
 			interrupt-parent = <&intc>;
-			interrupts = <31>;
+			interrupts = <31 1>;
 
 			reg-io-width = <1>;
 			reg-shift = <2>;
 			fifo-size = <1>;
 			no-loopback-test;
-
-			status = "disabled";
 		};
 
-		uart1: serial@2100 {
+		uart1: uart@2100 {
+			pinctrl-names = "default";
+			pinctrl-0 = <&enable_uart1>;
+
 			compatible = "ns16550a";
 			reg = <0x2100 0x100>;
 
-			clocks = <&lx_clk>;
+			clocks = <&ccu CLK_LXB>;
 
 			interrupt-parent = <&intc>;
-			interrupts = <30>;
+			interrupts = <30 0>;
 
 			reg-io-width = <1>;
 			reg-shift = <2>;
@@ -88,33 +170,23 @@
 			status = "disabled";
 		};
 
-		intc: interrupt-controller@3000 {
-			compatible = "realtek,rtl8380-intc", "realtek,rtl-intc";
-			reg = <0x3000 0x20>;
-			interrupt-controller;
-			#interrupt-cells = <1>;
-
-			interrupt-parent = <&cpuintc>;
-			interrupts = <2>, <3>, <4>, <5>, <6>;
-		};
-
-		watchdog: watchdog@3150 {
+		watchdog0: watchdog@3150 {
 			compatible = "realtek,rtl8380-wdt";
 			reg = <0x3150 0xc>;
 
 			realtek,reset-mode = "soc";
 
-			clocks = <&lx_clk>;
-			timeout-sec = <20>;
+			clocks = <&ccu CLK_LXB>;
+			timeout-sec = <30>;
 
 			interrupt-parent = <&intc>;
 			interrupt-names = "phase1", "phase2";
-			interrupts = <19>, <18>;
+			interrupts = <19 3>, <18 4>;
 		};
 
-		gpio0: gpio@3500 {
+		gpio0: gpio-controller@3500 {
 			compatible = "realtek,rtl8380-gpio", "realtek,otto-gpio";
-			reg = <0x3500 0x1c>;
+			reg = <0x3500 0x20>;
 
 			gpio-controller;
 			#gpio-cells = <2>;
@@ -123,7 +195,192 @@
 			interrupt-controller;
 			#interrupt-cells = <2>;
 			interrupt-parent = <&intc>;
-			interrupts = <23>;
+			interrupts = <23 3>;
+		};
+	};
+
+	switch0: ethernet-switch@1b000000 {
+		compatible = "realtek,rtl8380-switch", "realtek,otto-switch", "syscon", "simple-mfd";
+		reg = <0x1b000000 0x10000>;
+		interrupt-parent = <&intc>;
+		interrupts = <20 2>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		ethernet0: ethernet {
+			compatible = "realtek,rtl8380-eth";
+			interrupt-parent = <&intc>;
+			interrupts = <24 3>;
+			#interrupt-cells = <1>;
+			phy-mode = "internal";
+
+			fixed-link {
+				speed = <1000>;
+				full-duplex;
+			};
+		};
+
+		mdio_ctrl: mdio-controller {
+			compatible = "realtek,rtl8380-mdio", "realtek,otto-mdio";
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			mdio_bus0: mdio-bus@0 {
+				reg = <0>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+			};
+		};
+
+		mdio_aux: mdio-aux {
+			compatible = "realtek,rtl8380-aux-mdio";
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			status = "disabled";
+
+			pinctrl-names = "default";
+			pinctrl-0 = <&mdio_aux_mdx>, <&aux_mode_mdio>;
+		};
+
+		mdio_serdes: mdio-serdes {
+			compatible = "realtek,rtl8380-serdes-mdio";
+		};
+
+		pcs {
+			compatible = "realtek,rtl8380-pcs", "realtek,otto-pcs";
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			mdio-parent-bus = <&mdio_serdes>;
+
+			serdes0: serdes@0 {
+				reg = <0>;
+				#pcs-cells = <1>;
+			};
+			serdes1: serdes@1 {
+				reg = <1>;
+				#pcs-cells = <1>;
+			};
+			serdes2: serdes@2 {
+				reg = <2>;
+				#pcs-cells = <1>;
+			};
+			serdes3: serdes@3 {
+				reg = <3>;
+				#pcs-cells = <1>;
+			};
+			serdes4: serdes@4 {
+				reg = <4>;
+				#pcs-cells = <1>;
+			};
+			serdes5: serdes@5 {
+				reg = <5>;
+				#pcs-cells = <1>;
+			};
+		};
+
+		table {
+			compatible = "realtek,rtl8380-table", "realtek,otto-table";
+		};
+
+		soc_thermal: thermal {
+			compatible = "realtek,rtl8380-thermal";
+			#thermal-sensor-cells = <0>;
+		};
+	};
+
+	pinmux@1b000144 {
+		compatible = "pinctrl-single";
+		reg = <0x1b000144 0x4>;
+
+		pinctrl-single,bit-per-mux;
+		pinctrl-single,register-width = <32>;
+		pinctrl-single,function-mask = <0x1>;
+		#pinctrl-cells = <2>;
+
+		/* I2C mode */
+		aux_mode_i2c: i2c-pins {
+			pinctrl-single,bits = <0x0 0x0 0x1>;
+		};
+
+		/* MDIO mode */
+		aux_mode_mdio: mdx-pins {
+			pinctrl-single,bits = <0x0 0x1 0x1>;
+		};
+	};
+
+	pinmux: pinmux@1b001000 {
+		compatible = "pinctrl-single";
+		reg = <0x1b001000 0x4>;
+
+		pinctrl-single,bit-per-mux;
+		pinctrl-single,register-width = <32>;
+		pinctrl-single,function-mask = <0x1>;
+		#pinctrl-cells = <2>;
+
+		enable_uart1: pinmux_enable_uart1 {
+			pinctrl-single,bits = <0x0 0x10 0x10>;
+		};
+	};
+
+	/* LED_GLB_CTRL */
+	pinmux_led: pinmux@1b00a000 {
+		compatible = "pinctrl-single";
+		reg = <0x1b00a000 0x4>;
+
+		pinctrl-single,bit-per-mux;
+		pinctrl-single,register-width = <32>;
+		pinctrl-single,function-mask = <0x1>;
+		#pinctrl-cells = <2>;
+
+		/* enable GPIO 0 */
+		pinmux_disable_sys_led: disable_sys_led {
+			pinctrl-single,bits = <0x0 0x0 0x8000>;
+		};
+	};
+
+	pinmux@1b00a0e0 {
+		compatible = "pinctrl-single";
+		reg = <0x1b00a0e0 0x4>;
+
+		pinctrl-single,bit-per-mux;
+		pinctrl-single,register-width = <32>;
+		pinctrl-single,function-mask = <0x1>;
+		#pinctrl-cells = <2>;
+
+		/* Use SoC GPIO 2/3 as GPIO */
+		mdio_aux_gpio: gpio-pins {
+			pinctrl-single,bits = <0x0 0x0 0x1>;
+		};
+
+		/* Use SoC GPIO 2/3 as MDC/MDIO */
+		mdio_aux_mdx: mdx-pins {
+			pinctrl-single,bits = <0x0 0x1 0x1>;
+		};
+	};
+
+	sram0: sram@9f000000 {
+		compatible = "mmio-sram";
+		reg = <0x9f000000 0x10000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0 0x9f000000 0x10000>;
+	};
+
+	thermal_zones: thermal-zones {
+		cpu-thermal {
+			polling-delay-passive = <1000>;
+			polling-delay = <1000>;
+			coefficients = <1000 0>;
+			thermal-sensors = <&soc_thermal>;
+			trips {
+				cpu-crit {
+					temperature = <105000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
 		};
 	};
 };
-- 
