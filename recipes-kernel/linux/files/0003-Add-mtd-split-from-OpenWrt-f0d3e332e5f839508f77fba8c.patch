+++ b/drivers/mtd/mtdsplit/mtdsplit_fit.c
@@ -0,0 +1,361 @@
+/*
+ * Copyright (c) 2015 The Linux Foundation
+ * Copyright (C) 2014 Gabor Juhos <juhosg@openwrt.org>
+ *
+ * Permission to use, copy, modify, and/or distribute this software for any
